{
  "name": "lpviz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "check:workspace-imports": "node scripts/checkWorkspaceImports.mjs",
    "format": "prettier --write --print-width 3000 lpviz && bun lpviz/restoreAsciiArt.ts && bunx tsc && bunx knip",
    "deploy": "npx wrangler deploy --assets=./dist --name lpviz --compatibility-date 2025-09-01",
    "prdeploy": "npx wrangler versions upload --assets=./dist --name lpviz --compatibility-date 2025-09-01"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@lpviz/contracts": "workspace:*",
    "@lpviz/math": "workspace:*",
    "@lpviz/polytope": "workspace:*",
    "@lpviz/solver-engine": "workspace:*",
    "@lpviz/state": "workspace:*",
    "@lpviz/viewport": "workspace:*",
    "@lpviz/runtime": "workspace:*",
    "@react-three/fiber": "^9.5.0",
    "@types/react-virtualized": "^9.22.3",
    "jsoncrush": "^1.1.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtualized": "^9.22.6",
    "sprintf-js": "^1.1.3",
    "three": "^0.181.1",
    "wrangler": "^4.47.0"
  },
  "knip": {
    "entry": [
      "apps/web/src/main.tsx"
    ],
    "project": [
      "apps/web/src/**/*.ts",
      "apps/web/src/**/*.tsx",
      "packages/**/*.ts",
      "packages/**/*.tsx"
    ]
  }
}
