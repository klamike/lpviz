{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitThis": true,
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@lpviz/contracts": ["./packages/contracts/src/index.ts"],
      "@lpviz/math": ["./packages/math/src/index.ts"],
      "@lpviz/polytope": ["./packages/polytope/src/index.ts"],
      "@lpviz/solver-engine": ["./packages/solver-engine/src/index.ts"],
      "@lpviz/state": ["./packages/state/src/index.ts"],
      "@lpviz/state/react": ["./packages/state/src/react.ts"],
      "@lpviz/viewport": ["./packages/viewport/src/index.ts"],
      "@lpviz/viewport/react": ["./packages/viewport/src/react.ts"],
      "@lpviz/runtime": ["./packages/runtime/src/index.ts"]
    }
  }
}
